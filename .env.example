# Copia este fichero a .env y rellena tus credenciales. NUNCA subas .env a Git.

# --- MongoDB ---
# OPCION A (recomendada, coste 0): instancia local via docker compose
MONGO_URI=mongodb://tfm:tfm@localhost:27017/?authSource=admin
# OPCION B: Atlas M0 gratuito, solo para el subconjunto de demostracion
# MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB=logistica
MONGO_COLLECTION=telemetria_raw

# --- Rutas locales ---
RUTA_DESCARGAS=./datos/raw
RUTA_SILVER=./datos/silver
RUTA_EVIDENCIAS=./evidencias

# --- AWS (unico gasto real del proyecto) ---
AWS_REGION=eu-west-1
S3_BUCKET=tfm-logistica-pablo
REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftCopyRole

# --- Redshift Serverless ---
REDSHIFT_HOST=workgroup.123456789012.eu-west-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
